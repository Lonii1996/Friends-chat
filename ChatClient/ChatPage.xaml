<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatClient.ChatPage"
             Title="ChatPage">


    <Grid RowDefinitions="*, Auto" Padding="20">

        <!-- 1. Список сообщений чата -->
        <CollectionView x:Name="MessagesCollectionView" Grid.Row="0" Margin="0,0,0,10">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <VerticalStackLayout Padding="10" Margin="0,5">
                        <!-- Имя автора и время отправки -->
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{Binding Username}" FontAttributes="Bold" TextColor="#512bd4" FontSize="14"/>
                            <Label Text="{Binding LocalTimeText}" TextColor="Gray" FontSize="11" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <!-- Текст сообщения -->
                        <Label Text="{Binding Text}" TextColor="Black" FontSize="16" Margin="0,2,0,0"/>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- 2. Панель ввода внизу -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <Entry x:Name="MessageEntry"
                   Placeholder="Напишите сообщение..."
                   PlaceholderColor="Gray"
                   TextColor="White"
                   BackgroundColor="#1e1e1e"
                   HeightRequest="50"
                   Grid.Column="0"/>

            <Button Text="Отправить"
                    Clicked="OnSendClicked"
                    BackgroundColor="#512bd4"
                    TextColor="White"
                    FontAttributes="Bold"
                    WidthRequest="120"
                    HeightRequest="50"
                    Grid.Column="1"/>
        </Grid>
    </Grid>
</ContentPage>