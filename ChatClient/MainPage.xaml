<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChatClient.MainPage">

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="30" Spacing="20" MaximumWidthRequest="400">

            <Label Text="Чат для Друзей 💬"
                   TextColor="White"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <Entry x:Name="NameEntry"
                   Placeholder="Ваше имя (логин)"
                   PlaceholderColor="Gray"
                   TextColor="White"
                   BackgroundColor="#2d2d2d"
                   HeightRequest="50"/>

            <Entry x:Name="PasswordEntry"
                   Placeholder="Пароль"
                   PlaceholderColor="Gray"
                   TextColor="White"
                   IsPassword="True"
                   BackgroundColor="#2d2d2d"
                   HeightRequest="50"/>

           

            <Button Text="Войти"
                    Clicked="OnLoginClicked"
                    BackgroundColor="#512bd4"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Margin="0,10,0,0"/>

            <Button Text="Создать аккаунт"
                    Clicked="OnRegisterClicked"
                    BackgroundColor="Transparent"
                    TextColor="#512bd4"
                    BorderColor="#512bd4"
                    BorderWidth="2"
                    FontAttributes="Bold"
                    HeightRequest="50"/>
            <Label x:Name="StatusLabel"
       Text="🔍 Проверка связи с сервером..."
       TextColor="Yellow"
       FontSize="14"
       FontAttributes="Italic"
       HorizontalOptions="Center"
       Margin="0,0,0,10"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>